  (let ((_lp$25312 jv$clojure.core/attach-core-doc-meta!) (_la$25313 "clojure.core") (_la$25314 "deliver") (_la$25315 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$25316 (jolt-list (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$25312) (_lp$25312 _la$25313 _la$25314 _la$25315 _la$25316 jolt-nil) (jolt-invoke _lp$25312 _la$25313 _la$25314 _la$25315 _la$25316 jolt-nil))))
