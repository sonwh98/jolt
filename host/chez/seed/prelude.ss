  (let ((_lp$25262 jv$clojure.core/attach-core-doc-meta!) (_la$25263 "clojure.core") (_la$25264 "defmulti") (_la$25265 "Creates a new multimethod with the associated dispatch function.\n  The docstring and attr-map are optional.\n\n  Options are key-value pairs and may be one of:\n\n  :default\n\n  The default dispatch value, defaults to :default\n\n  :hierarchy\n\n  The value used for hierarchical dispatch (e.g. ::square is-a ::shape)\n\n  Hierarchies are type-like relationships that do not depend upon type\n  inheritance. By default Clojure's multimethods dispatch off of a\n  global hierarchy map.  However, a hierarchy relationship can be\n  created with the derive function used to augment the root ancestor\n  created with make-hierarchy.\n\n  Multimethods expect the value of the hierarchy option to be supplied as\n  a reference type e.g. a var (i.e. via the Var-quote dispatch macro #'\n  or the var special form).") (_la$25266 (jolt-list (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "docstring?") (jolt-symbol #f "attr-map?") (jolt-symbol #f "dispatch-fn") (jolt-symbol #f "&") (jolt-symbol #f "options"))))) (if (#3%procedure? _lp$25262) (_lp$25262 _la$25263 _la$25264 _la$25265 _la$25266 jolt-nil) (jolt-invoke _lp$25262 _la$25263 _la$25264 _la$25265 _la$25266 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$25267 jv$clojure.core/attach-core-doc-meta!) (_la$25268 "clojure.core") (_la$25269 "defn") (_la$25270 "Same as (def name (fn [params* ] exprs*)) or (def\n    name (fn ([params* ] exprs*)+)) with any doc-string or attrs added\n    to the var metadata. prepost-map defines a map with optional keys\n    :pre and :post that contain collections of pre or post conditions.") (_la$25271 (jolt-list (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "doc-string?") (jolt-symbol #f "attr-map?") (jolt-vector (jolt-symbol #f "params*")) (jolt-symbol #f "prepost-map?") (jolt-symbol #f "body")) (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "doc-string?") (jolt-symbol #f "attr-map?") (jolt-list (jolt-vector (jolt-symbol #f "params*")) (jolt-symbol #f "prepost-map?") (jolt-symbol #f "body")) (jolt-symbol #f "+") (jolt-symbol #f "attr-map?"))))) (if (#3%procedure? _lp$25267) (_lp$25267 _la$25268 _la$25269 _la$25270 _la$25271 jolt-nil) (jolt-invoke _lp$25267 _la$25268 _la$25269 _la$25270 _la$25271 jolt-nil))))
