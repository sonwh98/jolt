  (let ((_lp$30699 jv$clojure.core/attach-core-doc-meta!) (_la$30700 "clojure.core") (_la$30701 "dorun") (_la$30702 "When lazy sequences are produced via functions that have side\n  effects, any effects other than those needed to produce the first\n  element in the seq do not occur until the seq is consumed. dorun can\n  be used to force any effects. Walks through the successive nexts of\n  the seq, does not retain the head and returns nil.") (_la$30703 (jolt-list-pos 862 4 (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll"))))) (if (#3%procedure? _lp$30699) (_lp$30699 _la$30700 _la$30701 _la$30702 _la$30703 jolt-nil) (jolt-invoke _lp$30699 _la$30700 _la$30701 _la$30702 _la$30703 jolt-nil))))
