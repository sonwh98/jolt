;; Target-identified, booted compiler/eval public path, without Chez execution.
(##include "../boot.ss")
(define failures 0)
(define checks 0)
(define (public-check src expected)
  (set! checks (+ checks 1))
  (let ((got (guard (e (#t (string-append "HOST-ERROR: " (or (condition-message e) (object->string e)))))
               (jolt-pr-readable (jolt-compile-eval src "user")))))
    (if (equal? got expected)
        (printf "  ok     ~a => ~a\n" src got)
        (begin (set! failures (+ failures 1))
               (printf "  FAIL   ~a => ~s expected ~s\n" src got expected)))))
(public-check "(jolt.backend-scheme.session/target)" ":gambit")
(public-check "(:path (jolt.ffi/load-library \"build/gambit-ffi/libjoltffi-fixture.dylib\"))" "\"build/gambit-ffi/libjoltffi-fixture.dylib\"")
(public-check "((jolt.ffi/__cfn \"joltffi_fx_layout_version\" [] :int))" "42")
(public-check "((jolt.ffi/__cfn \"joltffi_fx_eintr\" [] :int32))" "4")
(public-check "(let [p (jolt.ffi/alloc 16)] (try (jolt.ffi/write p :uint64 18446744073709551615 1) (jolt.ffi/read p :uint64 1) (finally (jolt.ffi/free p))))" "18446744073709551615N")
(public-check "(let [p (jolt.ffi/string->ptr \"é\")] (try (jolt.ffi/ptr->string p) (finally (jolt.ffi/free p))))" "\"é\"")
(public-check "((jolt.ffi/__cfn \"joltffi_fx_errtext\" [:int] :string) 1)" "\"joltffi-error-one\"")
(public-check "((jolt.ffi/__cfn \"joltffi_fx_errtext\" [:int] :string) 0)" "nil")
(public-check "((jolt.ffi/__cfn \"joltffi_fx_vfcntl\" [:int :int :varargs :int] :int) 10 3 100)" "113")
(public-check "(let [f (jolt.ffi/__cfn \"joltffi_fx_socketlike\" [:int :int :int] :int {:capture-native-error true}) e (jolt.ffi/__cfn \"joltffi_fx_eacces\" [] :int)] (= (f -1 0 0) [-1 (e)]))" "true")
(public-check "((jolt.ffi/__cfn \"joltffi_fx_scalar_10\" [:float] :float) (float 0.25))" "0.25")
(public-check "((jolt.ffi/__cfn \"joltffi_fx_scalar_1\" [:bool] :bool) false)" "false")
;; Refusal guards must execute under the real :gambit emitter and stay catchable.
(public-check "(try (jolt.ffi/__layout [:struct [[:x :int]]]) (catch UnsupportedOperationException e :layout-refused))" ":layout-refused")
(public-check "(try ((jolt.ffi/__cfn \"joltffi_fx_layout_version\" [] :int :blocking)) (catch Throwable e (boolean (re-find #\"blocking ffi is unsupported\" (ex-message e)))))" "true")
(public-check "(try ((jolt.ffi/__cfn \"joltffi_fx_socketlike\" [:int :int :int] :int {:blocking true :capture-native-error true}) -1 0 0) (catch Throwable e (boolean (re-find #\"blocking ffi is unsupported\" (ex-message e)))))" "true")
(public-check "(try (jolt.ffi/__ccallable (fn [] 1) [] :int) (catch UnsupportedOperationException e :callable-refused))" ":callable-refused")
(public-check "(try (jolt.ffi/__cfn \"f\" [[:by-value [:struct [[:x :int]]]]] :int) (catch UnsupportedOperationException e :aggregate-refused))" ":aggregate-refused")
(public-check "(try (jolt.ffi/__cfn \"f\" [:int :&] :int) (catch UnsupportedOperationException e :runtime-tail-refused))" ":runtime-tail-refused")
(public-check "(try ((jolt.ffi/__cfn \"joltffi_fx_layout_version\" [:pointer :int] :pointer) 0 0) (catch Throwable e (boolean (re-find #\"unregistered shape\" (ex-message e)))))" "true")
(public-check "(let [p (jolt.ffi/alloc 8)] (try (jolt.ffi/write-bytes p \"abc\") (jolt.ffi/read-bytes p 3) (finally (jolt.ffi/free p))))" "\"abc\"")
(public-check "(:path (jolt.ffi/load-library {:darwin \"build/gambit-ffi/libjoltffi-fixture.dylib\"}))" "\"build/gambit-ffi/libjoltffi-fixture.dylib\"")
(public-check "(try (jolt.ffi/load-library \"/nonexistent/libjoltffi-missing.dylib\") (catch Throwable e (boolean (re-find #\"cannot load\" (ex-message e)))))" "true")
(public-check "(try (jolt.ffi/load-library \"build/gambit-ffi/libjoltffi-unloadable.dylib\") (catch Throwable e (boolean (re-find #\"is there but did not load.*libjoltffi-dep\" (ex-message e)))))" "true")
(public-check "(boolean (jolt.ffi/find-symbol \"joltffi_fx_layout_version\"))" "true")
(public-check "(jolt.ffi/find-symbol \"joltffi_absent\")" "nil")
(public-check "((jolt.ffi/__cfn \"joltffi_fx_vsetopt\" [:pointer :int :varargs :pointer] :int) 0 7 0)" "7")
(public-check "(= ((jolt.ffi/__cfn \"joltffi_fx_success_errno\" [:int :int :int] :int {:capture-native-error true}) 1 2 3) [6 7777])" "true")
(public-check "(try ((jolt.ffi/__cfn \"joltffi_absent\" [] :int)) (catch Throwable e (boolean (re-find #\"no entry\" (ex-message e)))))" "true")
(public-check "(jolt.ffi/string->ptr nil)" "0")
(public-check "(let [p (jolt.ffi/string->ptr \"abc\")] (try (jolt.ffi/ptr->string p 4) (finally (jolt.ffi/free p))))" "\"abc\"")
(public-check "(let [p (jolt.ffi/alloc 8)] (jolt.ffi/free p) (jolt.ffi/__size p))" "0")
(printf "gambitffi-public: ~a check(s), ~a failure(s)\n" checks failures)
(if (= failures 0) (begin (display "gambitffi-public: PASS — :gambit compiler + native gsi\n") (exit 0)) (exit 1))
