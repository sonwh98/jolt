;; BLAKE3 unkeyed 32-byte digest. Blocks and tree nodes run in Gambit, so
;; Yin's content addresses do not depend on a blocking foreign procedure.

(define blake3-iv
  '#(#x6a09e667 #xbb67ae85 #x3c6ef372 #xa54ff53a
     #x510e527f #x9b05688c #x1f83d9ab #x5be0cd19))
(define blake3-permutation '#(2 6 3 10 7 0 4 13 1 11 12 5 9 14 15 8))

(define (blake3-u32 x) (bitwise-and x #xffffffff))

(define (blake3-compress cv words counter size flags)
  (let ((v (vector-append cv (subvector blake3-iv 0 4)
                          (vector (blake3-u32 counter) (arithmetic-shift counter -32)
                                  size flags))))
    (define (mix a b c d x y)
      (define (add! index other extra)
        (vector-set! v index (blake3-u32 (+ (vector-ref v index) (vector-ref v other) extra))))
      (define (rotate! index other bits)
        (let ((value (bitwise-xor (vector-ref v index) (vector-ref v other))))
          (vector-set! v index
            (bitwise-ior (arithmetic-shift value (- bits))
                         (blake3-u32 (arithmetic-shift value (- 32 bits)))))))
      (add! a b x)
      (rotate! d a 16)
      (add! c d 0)
      (rotate! b c 12)
      (add! a b y)
      (rotate! d a 8)
      (add! c d 0)
      (rotate! b c 7))
    (let round ((m words) (i 0))
      (mix 0 4 8 12 (vector-ref m 0) (vector-ref m 1))
      (mix 1 5 9 13 (vector-ref m 2) (vector-ref m 3))
      (mix 2 6 10 14 (vector-ref m 4) (vector-ref m 5))
      (mix 3 7 11 15 (vector-ref m 6) (vector-ref m 7))
      (mix 0 5 10 15 (vector-ref m 8) (vector-ref m 9))
      (mix 1 6 11 12 (vector-ref m 10) (vector-ref m 11))
      (mix 2 7 8 13 (vector-ref m 12) (vector-ref m 13))
      (mix 3 4 9 14 (vector-ref m 14) (vector-ref m 15))
      (unless (= i 6)
        (let ((next (make-vector 16)))
          (do ((j 0 (+ j 1))) ((= j 16))
            (vector-set! next j (vector-ref m (vector-ref blake3-permutation j))))
          (round next (+ i 1)))))
    (let ((out (make-vector 8)))
      (do ((i 0 (+ i 1))) ((= i 8) out)
        (vector-set! out i (bitwise-xor (vector-ref v i) (vector-ref v (+ i 8))))))))

(define (blake3-chunk bytes from end counter)
  (let loop ((at from) (cv blake3-iv))
    (let* ((size (min 64 (- end at)))
           (last? (= (+ at size) end))
           (flags (+ (if (= at from) 1 0) (if last? 2 0)))
           (words (make-vector 16 0)))
      (do ((i 0 (+ i 1))) ((= i size))
        (let ((word (quotient i 4)))
          (vector-set! words word
            (bitwise-ior (vector-ref words word)
                         (arithmetic-shift (u8vector-ref bytes (+ at i)) (* 8 (modulo i 4)))))))
      (if last?
          (list cv words counter size flags)
          (loop (+ at size) (blake3-compress cv words counter size flags))))))

(define (blake3-parent left right)
  (list blake3-iv (vector-append left right) 0 64 4))

(define (gambit-yin-blake3 bytes)
  (define (merge cv count stack)
    (if (odd? count)
        (cons cv stack)
        (merge (apply blake3-compress (blake3-parent (car stack) cv))
               (quotient count 2)
               (cdr stack))))
  (let ((n (u8vector-length bytes)))
    (let loop ((from 0) (counter 0) (stack '()))
      (let* ((end (min n (+ from 1024)))
             (output (blake3-chunk bytes from end counter)))
        (if (< end n)
            (loop end (+ counter 1)
                  (merge (apply blake3-compress output) (+ counter 1) stack))
            (let root ((output output) (left stack))
              (if (pair? left)
                  (root (blake3-parent (car left) (apply blake3-compress output)) (cdr left))
                  (let* ((words (blake3-compress (car output) (cadr output) 0
                                                 (cadddr output) (+ 8 (list-ref output 4))))
                         (digest (make-u8vector 32)))
                    (do ((i 0 (+ i 1))) ((= i 32) digest)
                      (u8vector-set! digest i
                        (bitwise-and 255 (arithmetic-shift (vector-ref words (quotient i 4))
                                                          (- (* 8 (modulo i 4)))))))))))))))
