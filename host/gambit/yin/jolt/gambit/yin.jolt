(ns jolt.gambit.yin
  "Yin's shared durable-store composition and Gambit's host modules."
  (:require [dao.jing :as jing]
            [jolt.ffi :as ffi]
            [yin.repl.main :as main]
            [yin.repl.store :as store]
            [yin.shell.main :as shell]
            [yin.vm :as vm]
            [yin.vm.module :as module]))

(defn- activate-ffi [registry]
  (module/register-host-module
    registry 'jolt.ffi
    {'sizeof ffi/sizeof}
    {'sizeof (vm/primitive-profile 'sizeof :pure [1] #{} :none)}))

(defn- materialize-sha256 [value]
  (jing/materialize! (store/open :mem) value {:algorithm :sha256}))

(defn- activate-store [registry]
  (module/register-host-module
    registry 'dao.jing.mem
    {'materialize-sha256 materialize-sha256}
    {'materialize-sha256
     (vm/primitive-profile 'materialize-sha256 :pure [1] #{} :none)}))

(def ^:private gambit-engine-inputs
  {:host-modules {'jolt.ffi activate-ffi
                  'dao.jing.mem activate-store}})

(defn- open-memory-dht []
  (let [join (requiring-resolve 'dao.space.dht/join)
        payload-budget (requiring-resolve 'dao.space.dht/payload-budget)
        local (store/open :mem)
        node (try
               (join {:local local})
               (catch Throwable e
                 (jing/close! local)
                 (throw e)))
        handle (:handle node)]
    (try
      {:index-store handle
       :publication-policy {:max-payload-bytes (payload-budget node)}}
      (catch Throwable e
        (jing/close! handle)
        (throw e)))))

(defn- open-store [spec opts]
  (let [opened (if (= spec :dht)
                 (open-memory-dht)
                 ((:open shell/composition) spec opts))]
    (update-in opened [:engine-inputs :host-modules]
               merge (:host-modules gambit-engine-inputs))))

(defn- parse-store [arg]
  (if (= arg "dht:") :dht ((:parse-store-arg shell/composition) arg)))

(defn- parse-store-command [args]
  (if (= ["dht:"] (vec args))
    {:spec :dht :label "dht:" :opts {:index-store-spec :dht}}
    ((:parse-store-command shell/composition) args)))

(def ^:private composition
  (assoc shell/composition
         :composition-spec? (constantly true)
         :parse-store-arg parse-store
         :parse-store-command parse-store-command
         :open open-store
         :help-lines (into (:help-lines shell/composition)
                           [""
                            "Gambit also accepts dht: with memory backing."
                            "WebSocket serving and signed DHT names and heads are unavailable."])))

(defn -main [& args]
  (main/main! args composition))
