;; Runtime assertions run inside the captured Jolt module.
(primitive-load "host/guile/boot.ss")
(define gate (cadr (command-line)))

(define (check label actual expected)
  (unless (equal? actual expected)
    (error 'guile-gate label 'actual actual 'expected expected))
  (format #t "~a: ~a = ~s\n" gate label actual))

(define (walk-executable form visit)
  (when (and (pair? form) (not (eq? (car form) 'quote)))
    (visit form)
    (walk-executable (car form) visit)
    (let loop ((args (cdr form)))
      (when (pair? args)
        (walk-executable (car args) visit)
        (loop (cdr args))))))

(define (check-emitted scheme)
  (let ((port (open-input-string scheme)))
    (let loop ((form (read port)))
      (unless (eof-object? form)
        (walk-executable form
          (lambda (expression)
            (let ((head (car expression)))
              (when (and (symbol? head)
                         (or (memq head '(foreign-procedure foreign-callable
                                         define-ftype make-ftype-pointer ftype-&ref &))
                             (string-prefix? "##" (symbol->string head))
                             (string-prefix? "#3%" (symbol->string head))))
                (error 'guileeval "forbidden executable head" head)))))
        (loop (read port))))))

(define (source text expected . required-text)
  (let* ((out (open-output-string))
         (actual (parameterize ((jolt-aot-capture out))
                   (jolt-pr-readable (jolt-compile-eval text "user"))))
         (scheme (get-output-string out)))
    (when (string=? gate "guileeval")
      (call-with-port (open-file (getenv "JOLT_GUILE_EMITTED") "a")
        (lambda (port) (display scheme port)))
      (for-each (lambda (expected-head)
                  (check (string-append text " emits " expected-head)
                         (and (string-contains scheme expected-head) #t) #t))
                required-text)
      (check-emitted scheme))
    (check text actual expected)))

(define (read-inventory path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((item (read port)) (items '()))
        (if (eof-object? item) (reverse items)
            (loop (read port) (cons item items)))))))

(define (order-names names)
  (list-sort (lambda (a b) (string<? (object->string a) (object->string b))) names))

(define (target)
  ((var-deref "jolt.backend-scheme.session" "target")))

(define (seed-references visit)
  (for-each
    (lambda (file)
      (call-with-input-file (%jolt-guile-path file)
        (lambda (port)
          (let loop ((form (read port)))
            (unless (eof-object? form)
              (walk-executable form visit)
              (loop (read port)))))))
    '("seed/prelude.ss" "seed/image.ss")))

(case (string->symbol gate)
  ((guilekernel)
   (check "keyword intern identity" (eq? (keyword #f "a") (keyword #f "a")) #t)
   (check "signed hash" (murmur3-hash-int 1) -68075478)
   (check "vector indexing" (pvec-nth! (jolt-vector 11 22) 1) 22)
   (check "map get" (jolt-get (jolt-hash-map "a" 7) "a") 7)
   (check "sequence" (seq->list (jolt-seq (jolt-vector 1 2 3))) '(1 2 3))
   (let ((cell (def-var! "kernel.gate" "root" 1)))
     (def-var! "kernel.gate" "root" 2)
     (check "record var updated" (var-cell-deref cell) 2))
   (let* ((runs (make-atomic-box 0))
          (start (make-mutex))
          (cell (cseq-lazy 0
                  (lambda ()
                    (atomic-box-swap! runs (+ 1 (atomic-box-ref runs)))
                    (cseq-realized 9 jolt-nil)))))
     (mutex-acquire start)
     (let ((force (lambda ()
                    (mutex-acquire start)
                    (mutex-release start)
                    (seq-first (seq-more cell)))))
       (let ((first (fork-thread force))
             (second (fork-thread force)))
         (mutex-release start)
         (check "first force" (join-thread first) 9)
         (check "second force" (join-thread second) 9)
         (check "thunk ran once" (atomic-box-ref runs) 1)))))
  ((guileboot guileeval guileprofile)
   (if (string=? %jolt-profile "kernel")
       (begin
         (check "kernel collection" (pvec-nth! (jolt-vector 5) 0) 5)
         (check "compiler absent from kernel"
                (var-cell-lookup "jolt.backend-scheme" "set-target!") #f))
       (begin
         (check "compiler target" (eq? (target) (keyword #f "guile")) #t)
         (source "(+ 20 22)" "42")
         (cond
           ((string=? gate "guileeval")
            (source "(def gate-value 17)" "#'user/gate-value")
            (source "(when true gate-value)" "17")
            (source "(def gate-value 42)" "#'user/gate-value")
            (source "(let [v [1 2 3]] (nth v 2))" "3")
            (source "((fn ([x] x) ([x & xs] (count xs))) 1 2 3)" "2")
            (source "(try (throw (ex-info \"gate\" {})) (catch Exception e (ex-message e)))" "\"gate\"")
            (source "(assoc {:a 1} :b 2)" "{:a 1, :b 2}")
            (source "(reduce + (map inc (range 5)))" "15")
            (source "(.length \"Guile\")" "5")
            (source "#?(:guile 42 :default 0)" "42")
            (source "(let [make (fn [x] (^:once fn* [] x)) f (make 42)] (f))"
                    "42" "jolt-once-tag" "vector-ref" "vector-set!")
            (source "(try ((jolt.ffi/__cfn \"jolt_gate_unavailable\" [] :int32))
                          (catch Exception e (ex-message e)))"
                    "\"jolt.guile: user FFI is unsupported on the guile target\""
                    "(sa-foreign-procedure a" "(sa-foreign-procedure  \"jolt_gate_unavailable\"")
            ((var-deref "jolt.backend-scheme" "set-var-cache!") #t)
            (source "(defprotocol GateShape (gate-perimeter [shape]))" "#'user/gate-perimeter"
                    "jolt-pic-site-make" "jolt-pic-site-ref" "jolt-pic-site-set!"
                    "jolt-proto-epoch-ref")
            (source "(defrecord GateSquare [width] GateShape
                       (gate-perimeter [shape] (* 4 (:width shape))))" "nil")
            (source "(gate-perimeter (->GateSquare 5))" "20")
            (source "(gate-perimeter (->GateSquare 11))" "44")
            (source "(defn gate-instance [cls value] (instance? cls value))"
                    "#'user/gate-instance" "jolt-instance-site")
            (source "(gate-instance GateSquare (->GateSquare 5))" "true")
            ((var-deref "jolt.backend-scheme" "set-trace-frames!") #t)
            (source "(try (+ 40 2) (catch Exception e 0))" "42" "jolt-catch-enter!")
            (%jolt-reset-compiler!)
            (check "reset compiler target" (eq? (target) (keyword #f "guile")) #t)
            (source "gate-value" "42"))
           ((string=? gate "guileprofile")
            (if (string=? %jolt-profile "full")
                (source "(re-matches #\"a+\" \"aaa\")" "\"aaa\"")
                (source "(try (re-pattern \"a+\") (catch Exception e (ex-message e)))"
                        "\"clojure.core/re-pattern is unsupported on the guile target: regex is unavailable in the repl profile\""))))))
   (when (string=? gate "guileboot") (display "BOOT-OK\n")))
  ((guilevars guilestatics)
   (let ((references (make-hashtable equal-hash equal?)))
     (seed-references
       (lambda (form)
         (let ((head (car form)) (args (cdr form)))
           (define (record-names fields count)
             (when (and (list? fields) (>= (length fields) count))
               (let ((names ((@ (srfi srfi-1) take) fields count)))
                 (when (for-all string? names)
                   (hashtable-set! references names #t)))))
           (if (string=? gate "guilevars")
               (when (memq head '(jolt-var var-deref))
                 (record-names args 2))
               (case head
                 ((host-static-call host-static-ref)
                  (record-names args 2))
                 ((host-static-ref-site host-static-proc-site)
                  (when (pair? args) (record-names (cdr args) 2)))
                 ((host-new) (record-names args 1)))))))
     (let* ((names (vector->list (hashtable-keys references)))
            (missing
              (filter
                (lambda (name)
                  (cond
                    ((string=? gate "guilevars")
                     (let ((cell (apply var-cell-lookup name)))
                       (or (not cell) (jolt-var-unbound? (var-cell-root cell)))))
                    ((null? (cdr name)) (not (lookup-class class-ctors-tbl (car name))))
                    (else (eq? host-static-miss (apply host-static-lookup name)))))
                names)))
       (check "nonempty seed reference inventory" (pair? names) #t)
       (let ((expected (if (string=? gate "guilestatics")
                           (read-inventory "host/guile/seed-statics-allowlist.ss")
                           '())))
         (check "missing seed references" (order-names missing) (order-names expected))
         (for-each
           (lambda (name)
             (let ((message
                     (guard (condition
                              ((jolt-throw-condition? condition)
                               (jolt-ex-info-record-message (jolt-unwrap-throw condition))))
                       (if (null? (cdr name))
                           (host-new (car name))
                           (apply host-static-ref name))
                       #f)))
               (check (string-append "named refusal " (car name))
                      (and (string? message) (string-contains message (car name))
                           (string-contains message "unsupported") #t)
                      #t)))
           expected)))))
  ((guiletwins)
   (let ((heads (read-inventory (getenv "JOLT_GUILE_HEADS")))
         (procedures (read-inventory (getenv "JOLT_GUILE_VALUE_HEADS"))))
     (check "derived call and value inventories" (and (pair? heads) (pair? procedures)) #t)
     (for-each
       (lambda (head)
         (let ((binding (module-variable (interaction-environment) head)))
           (unless (and binding (variable-bound? binding)
                        (let ((value (variable-ref binding)))
                          (or (procedure? value)
                              (and (macro? value)
                                   ((@ (srfi srfi-1) any) (lambda (operands)
                                          (guard (e ((syntax-violation? e) #f))
                                            (macroexpand (cons head operands))
                                            #t))
                                        '((1 2) (1) (1 2 3) ()))))))
             (error 'guiletwins "missing callable or expandable head" head))))
       heads)
     (for-each
       (lambda (head)
         (unless (procedure? (eval head (interaction-environment)))
           (error 'guiletwins "missing value-position procedure" head)))
       procedures)
     (check "checked numeric macro invocation" (eval '(jolt-n+ 1 2)) 3)
     (check "value-position predicate invocation" ((eval 'jolt-nil?-fn) jolt-nil) #t)))
  (else (error 'guile-gate "unknown gate" gate)))

(format #t "~a: PASS (~a)\n" gate %jolt-profile)
