 {:suite :core-prims
  :label "Scheme eval with bracket bindings and big-endian double writer and u64 reader"
  :expr "(jolt.scheme/eval-string \"(let ([bv (make-bytevector 8)]) (bytevector-ieee-double-set! bv 0 -1.5 (endianness big)) (bytevector-u64-ref bv 0 (endianness big)))\")"
  :expected "13832806255468478464N"}
 {:suite :core-prims
