  :expr "(jolt.scheme/eval-string \"(let ([bv (make-bytevector 8)]) (bytevector-u32-set! bv 0 #xbff80000 (endianness big)) (bytevector-u32-set! bv 4 0 (endianness big)) (bytevector-ieee-double-ref bv 0 (endianness big)))\")"
  :expected "-1.5"}
 {:suite :core-arrays
  :label "System.arraycopy preserves overlapping values"
  :expr "(let [a (to-array [:a :b :c :d])] [(System/arraycopy a 0 a 1 3) (vec a)])"
  :expected "[nil [:a :a :b :c]]"}
 {:suite :core-arrays
  :label "Arrays.sort is a stable in-place sort"
  :expr "(let [a (object-array [[2 :a] [1 :b] [2 :c] [1 :d]])] [(java.util.Arrays/sort a (fn [x y] (compare (first x) (first y)))) (vec a)])"
  :expected "[nil [[1 :b] [1 :d] [2 :a] [2 :c]]]"}
 {:suite :yin-blake3
  :label "BLAKE3 known answer for 0 bytes"
  :expr "(let [b (byte-array (map #(unchecked-byte (mod % 251)) (range 0)))] (apply str (map (fn [x] (let [v (bit-and x 255) h \"0123456789abcdef\"] (str (nth h (quot v 16)) (nth h (mod v 16))))) (jolt.scheme/call \"gambit-yin-blake3\" b))))"
  :expected "\"af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262\""}
